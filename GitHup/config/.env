# Development Environment - Local
MYSQL_ROOT_PASSWORD=dev_root_pass_change_in_production
DB_USERNAME=talento_user
DB_PASSWORD=dev_db_pass_change_in_production

JWT_SECRET=dev_jwt_secret_change_in_production_min_32_chars
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5174

SPRING_PROFILES_ACTIVE=docker
REACT_ENV=development
NODE_ENV=development

SSL_ENABLED=false
RATE_LIMIT_PER_MINUTE=120
LOG_LEVEL=DEBUG
AUDIT_LOGGING=false

REDIS_HOST=redis
REDIS_PORT=6379

VITE_API_URL=http://localhost:8080
